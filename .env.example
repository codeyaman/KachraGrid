# ══════════════════════════════════════════════════════════════
# KachraGrid v2 — Environment & API Configuration
# BBMP Ward 142 (Jayanagar), Bangalore Civic Waste Management
# ══════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────
# 1. SERVER & SYSTEM SETTINGS
# ──────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_PORT=5001
FLASK_HOST=0.0.0.0
SECRET_KEY=kachragrid_secret_key_bbmp_ward142_2025
DATABASE_URL=sqlite:///data/kachragrid.db

# ──────────────────────────────────────────────────────────────
# 2. WARD 142 CIVIC & LOGISTICS PARAMETERS
# ──────────────────────────────────────────────────────────────
CITY_NAME=Bangalore
WARD_NUMBER=142
WARD_NAME=Jayanagar
WARD_CENTER_LAT=12.9250
WARD_CENTER_LON=77.5830
DIESEL_RATE_PER_LITER=89.0
TRADITIONAL_FIXED_ROUTE_KM=32.5

# ──────────────────────────────────────────────────────────────
# 3. HUGGING FACE & LOCAL NEURAL MODELS
# ──────────────────────────────────────────────────────────────
# Paste your personal Hugging Face user access token (hf_...)
# Required if downloading gated models like meta-llama/Llama-3.1-8B-Instruct
HF_TOKEN=

# Inference Device: 'mps' (Apple Silicon Mac), 'cuda' (NVIDIA GPU), or 'cpu'
HF_DEVICE=mps

# Model Repositories
HF_TEXT_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
HF_VOICE_MODEL=openai/whisper-small
HF_TRANSLATION_MODEL=facebook/nllb-200-distilled-600M

# Zero-Lag Fast Heuristic Mode: Set to 'true' for instant sub-second responses
# without needing 16GB+ VRAM model downloads. Set to 'false' for full weights.
AI_OFFLINE_FAST_MODE=true

# ──────────────────────────────────────────────────────────────
# 4. OPTIONAL CLOUD AI PROVIDERS (ALTERNATIVE BACKENDS)
# ──────────────────────────────────────────────────────────────
# OpenAI API Key for GPT-4o Vision or Whisper cloud inference
OPENAI_API_KEY=

# Google Gemini API Key for Gemini 2.5 Flash / Pro Vision diagnostics
GEMINI_API_KEY=

# OpenRouter API Key for vision and reasoning models
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Anthropic API Key for Claude 3.5 Sonnet civic analysis
ANTHROPIC_API_KEY=

# ──────────────────────────────────────────────────────────────
# 5. MAPPING, GIS & LIVE ROUTING APIS
# ──────────────────────────────────────────────────────────────
# CARTO Map Base API & Basemap Configuration
# (Voyager, Positron, or Dark Matter tiles, or custom CARTO account API key)
CARTO_API_KEY=
CARTO_USERNAME=
CARTO_MAP_STYLE=voyager
VITE_CARTO_API_KEY=
VITE_CARTO_MAP_STYLE=voyager

# Mapbox token for high-res satellite / terrain custom map tiles
MAPBOX_ACCESS_TOKEN=
VITE_MAPBOX_ACCESS_TOKEN=

# OpenRouteService API key for live Dijkstra road matrix routing
OPENROUTE_SERVICE_API_KEY=

# ──────────────────────────────────────────────────────────────
# 6. CITIZEN ALERTS & DISPATCH NOTIFICATIONS (OPTIONAL)
# ──────────────────────────────────────────────────────────────
# Twilio for SMS alerts to citizen phone numbers upon compactor dispatch
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# BBMP Redressal WhatsApp Bot API Token
WHATSAPP_API_TOKEN=

# ──────────────────────────────────────────────────────────────
# 7. FRONTEND VITE CONFIGURATION
# ──────────────────────────────────────────────────────────────
VITE_API_BASE_URL=/api
VITE_WARD_NUMBER=142
VITE_WARD_NAME=Jayanagar
